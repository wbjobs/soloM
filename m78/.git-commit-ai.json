{
  "llm": {
    "provider": "ollama",
    "baseUrl": "http://localhost:11434",
    "model": "llama3",
    "maxContextLength": 4000,
    "options": {
      "temperature": 0.7,
      "top_p": 0.9
    }
  },
  "commit": {
    "maxLength": 72,
    "language": "zh-CN",
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ]
  }
}