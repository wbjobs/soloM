{
  "name": "nes-emulator",
  "version": "1.0.0",
  "description": "NES Emulator with C++ core, Electron shell, and React UI",
  "main": "src/main/main.js",
  "scripts": {
    "install": "echo Skipping native build - run npm run build:native manually",
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:react": "webpack serve --mode development",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build": "webpack --mode production",
    "build:native": "node-gyp rebuild",
    "start": "electron ."
  },
  "dependencies": {
    "electron": "^28.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.29.7",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.9.0",
    "html-webpack-plugin": "^5.6.0",
    "node-addon-api": "^7.1.0",
    "node-gyp": "^10.0.1",
    "style-loader": "^3.3.4",
    "typescript": "^6.0.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
