# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=rag_documents

# Embedding Model Configuration
EMBEDDING_MODEL_PATH=./models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

# LLM Configuration
LLM_MODEL_PATH=./models/Qwen2-7B-Instruct
LLM_DEVICE=cpu
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# PDF Parsing Configuration
# Table detection tolerance (pixels). Higher values merge nearby lines into tables.
PDF_TABLE_TOLERANCE=3

# BM25 Configuration
# BM25 term frequency saturation parameter (typical: 1.2-2.0)
BM25_K1=1.5
# BM25 document length normalization (typical: 0.75)
BM25_B=0.75

# Hybrid Search Configuration
# Weight for vector similarity score in hybrid search
HYBRID_VECTOR_WEIGHT=0.7
# Weight for BM25 keyword score in hybrid search
HYBRID_BM25_WEIGHT=0.3

# FastAPI Configuration
HOST=0.0.0.0
PORT=8000

# File Storage
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=10485760
